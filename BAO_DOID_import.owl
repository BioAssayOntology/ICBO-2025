    <!-- http://purl.obolibrary.org/obo/DOID_3265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080001"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_3262"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_37"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_850"/>
        <obo:IAO_0000115>A phagocyte bactericidal dysfunction characterized by an inability to resist repeated infectious diseases and a tendency to develop chronic inflammation. Life-threatening recurrent fungal and bacterial infections affecting the skin, lungs, and bones may occur along with swollen areas of inflamed tissues known as granulomas that can be widely distributed.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>GARD:6100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:D71</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D006105</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C26788</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:379</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:11210002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0018203</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Bridges-Good syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">CGD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Congenital dysphagocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Quie syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3265</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#DO_rare_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#NCIthesaurus"/>
        <rdfs:comment>Xref MGI.
OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label>chronic granulomatous disease</rdfs:label>
    </owl:Class>
    


