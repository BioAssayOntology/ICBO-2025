    <!-- http://purl.obolibrary.org/obo/DOID_2841 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2841">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1176"/>
        <obo:IAO_0000115>A bronchial disease that is characterized by chronic inflammation and narrowing of the airways, which is caused by a combination of environmental and genetic factors. The disease has_symptom recurring periods of wheezing (a whistling sound while breathing), has_symptom chest tightness, has_symptom shortness of breath, has_symptom mucus production and has_symptom coughing.</obo:IAO_0000115>
