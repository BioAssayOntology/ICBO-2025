    <!-- http://purl.obolibrary.org/obo/DOID_14444 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_14444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9858"/>
        <obo:IAO_0000115>A deep keratitis that is characterized by inflammation of the anterior sclera and subsequent inflammation of the adjacent cornea with opacification of the corneal stroma and has_symptom pain, red eyes, photophobia, tearing, and blurry vision. Sclerosing keratitis is caused by severe anterior scleritis that causes inflammation and injury to the adjacent corneal layer.  Anterior scleritis can be caused by autoimmune diseases, connective tissue diseases, and infection.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
