    <!-- http://purl.obolibrary.org/obo/DOID_9159 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050339"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080000"/>
        <obo:IAO_0000115>A commensal bacterial infectious disease that results in infection, located in muscle tissue, has_material_basis_in Clostridium perfringens, which produce gas that becomes trapped in the infected tissue. Gas gangrene usually develops after injuries or surgery. The infection has symptom large blisters, has symptom pain in the infected area, has symptom myonecrosis, has symptom gas production, and has symptom sepsis.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>ICD10CM:A48.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:040.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D005738</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:186413007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0017105</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Gas bacillus infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Gas gangrene</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Myonecrosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9159</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#gram-positive_bacterial_infectious_disease"/>
        <rdfs:label>gas gangrene</rdfs:label>
    </owl:Class>
    


