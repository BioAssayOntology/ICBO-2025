    <!-- http://purl.obolibrary.org/obo/DOID_13819 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13819">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050339"/>
