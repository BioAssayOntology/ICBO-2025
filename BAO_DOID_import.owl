        <oboInOwl:hasDbXref>NCI:C3108</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:86406008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0019693</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">HIV infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:526</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#zoonotic_infectious_disease"/>
        <rdfs:label>human immunodeficiency virus infectious disease</rdfs:label>
    </owl:Class>
    


