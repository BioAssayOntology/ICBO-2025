        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2218"/>
        <obo:IAO_0000115>A blood coagulation disease characterized by autosomal recessive inheritance of failure of platelet aggregation and absent or diminished clot retraction that has material_basis_in mutation in the ITGA2B or ITGB3 genes on chromosome 17q21.32.</obo:IAO_0000115>
