    <!-- http://purl.obolibrary.org/obo/DOID_2365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_934"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_936"/>
        <obo:IAO_0000115>A viral infectious disease that results in inflammation located in brain, has_material_basis_in West Nile virus, which is transmitted_by Culex, transmitted by Aedes, and transmitted_by Anopheles species of mosquitoes. The infection has_symptom high fever, has_symptom headache, has_symptom neck stiffness, has_symptom stupor, has_symptom disorientation, has_symptom coma, has_symptom tremors, has_symptom convulsions, has_symptom muscle weakness, has_symptom vision loss, has_symptom numbness, and has_symptom paralysis.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>GARD:9959</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A92.31</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:066.41</oboInOwl:hasDbXref>
