    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_3263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050736"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_16"/>
        <obo:IAO_0000115>An integumentary system disease characterized by congenital absence of melanocytes in areas of the skin and hair that has_material_basis_in heterozygous mutation in either KIT or SNAI2 on chromosome 4q12 or 8q11.21, respectively.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>GARD:4344</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:E70.39</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D016116</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C85009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OMIM:172800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:2884</oboInOwl:hasDbXref>
