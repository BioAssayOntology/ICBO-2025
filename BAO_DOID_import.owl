        <oboInOwl:hasDbXref>NCI:C2914</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:154404004</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0700345</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Candidal vulvovaginitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Candidal: cervix</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Candidiasis of vulva and vagina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Monilial vulvovaginitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Vulvovaginal Candidiasis</oboInOwl:hasExactSynonym>
