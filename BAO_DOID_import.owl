    <!-- http://purl.obolibrary.org/obo/DOID_9210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1756"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_4953"/>
        <obo:IAO_0000115>A viral infectious disease that results_in inflammation located_in facial nerve, which leads to paralysis of one side of the face, has_material_basis_in Human herpesvirus 3, which reactivates after appearing as chickenpox in childhood. The infection has_symptom vesicular rash of the ear or mouth, has_symptom tinnitus, has_symptom vertigo, has_symptom otalgia, and has_symptom headache.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
