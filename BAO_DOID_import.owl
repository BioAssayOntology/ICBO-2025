    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_612"/>
        <obo:IAO_0000115>A primary immunodeficiency disease where phagocytes have a diminished ability to fight bacterial infection.</obo:IAO_0000115>
