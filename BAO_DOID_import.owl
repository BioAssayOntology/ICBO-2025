    <!-- http://purl.obolibrary.org/obo/DOID_11258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_11102"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9942"/>
        <obo:IAO_0000115>A bartonellosis that results_in infection located_in lymph node, has_material_basis_in Bartonella henselae or has_material_basis_in Bartonella clarridgeiae, which are transmitted_by scratch or bite of a kitten, or transmitted_by contact of animal&apos;s saliva with an eye or through broken skin. The infection has_symptom regional lymphadenopathy, has_symptom headache, has_symptom chills, has_symptom backache, and has_symptom abdominal pain.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>ICD10CM:A28.1</oboInOwl:hasDbXref>
