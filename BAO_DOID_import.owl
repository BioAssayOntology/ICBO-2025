    <!-- http://purl.obolibrary.org/obo/DOID_8912 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_8912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050133"/>
        <obo:IAO_0000115>A superficial mycosis that is a superficial fungal infection of the skin characterized by brown to black macules which usually occur on the palmar aspects of hands and occasionally the plantar and other surfaces of the skin, caused by Hortaea werneckii, which is a common saprophytic fungus believed to occur in soil, compost, humus and on wood in humid tropical and sub-tropical regions.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>ICD10CM:B36.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:111.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:1022006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0152067</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Infection by Cladosporium werneckii</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Keratomycosis nigricans</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Tinea palmaris nigra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym xml:lang="en">microsporosis nigra</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>DOID:8912</oboInOwl:id>
        <rdfs:label>tinea nigra</rdfs:label>
    </owl:Class>
    


