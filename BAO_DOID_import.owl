    <!-- http://purl.obolibrary.org/obo/DOID_12531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_12531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1247"/>
        <obo:IAO_0000115>A blood coagulation disease that is a hereditary abnormality which slows the blood clotting process. It arises from a qualitative or quantitative deficiency of von Willebrand factor (vWF), a multimeric protein that is required for platelet adhesion.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
