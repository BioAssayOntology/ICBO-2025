        <oboInOwl:hasDbXref>UMLS_CUI:C0751583</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">West Nile Fever with encephalitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">West Nile fever encephalitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:2365</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#zoonotic_infectious_disease"/>
        <rdfs:label>West Nile encephalitis</rdfs:label>
    </owl:Class>
    


