    <!-- http://purl.obolibrary.org/obo/DOID_0050456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050338"/>
        <obo:IAO_0000115>A primary bacterial infectious disease that results_in infection located_in skin or located_in subcutaneous tissue, has_material_basis_in Mycobacterium ulcerans, which could be transmitted_by insects. The bacterium produces a toxin, named mycolactone, which causes subcutaneous fat necrosis and inhibits an immune response. The infection has_symptom nodule, which is a painless, mobile swelling in the skin.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>GARD:9520</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A31.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D054312</oboInOwl:hasDbXref>
