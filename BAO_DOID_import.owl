        <oboInOwl:hasExactSynonym xml:lang="en">von Willebrand&apos;s-Jurgens&apos; disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">von Willebrand-Jrgens disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
