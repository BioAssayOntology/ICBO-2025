    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060668">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2490"/>
        <obo:IAO_0000115>A congenital nervous system abnormality characterized by failure of the anterior neuropore to close resulting in partial or complete absence of the cranial vault accompanied by absence of overlying tissues, including the brain and cerebral hemispheres, skull and scalp.</obo:IAO_0000115>
