    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_13964 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13964">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9669"/>
        <obo:IAO_0000115>A senile cataract that is characterized by dense white opacification of the lens and milky fluid in the lens capsule such that the dense nucleus of the lens sinks in the surrounding fluid. It is the late stage of senile cataracts and is caused by a multifactorial etiology related to aging.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
