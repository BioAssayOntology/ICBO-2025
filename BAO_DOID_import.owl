    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2256"/>
        <obo:IAO_0000115>An osteochondrodysplasia that has_material_basis_in deficient endochondral ossification which results_in dwarfism, short-trunk, short-limbed, anascara, disaprportionately large cranium, and a narrow chest which leads to death in utero or during early neonatal period.</obo:IAO_0000115>
