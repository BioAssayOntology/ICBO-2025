        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:240466002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0276180</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3292</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#zoonotic_infectious_disease"/>
        <rdfs:label>monkeypox</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_3298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_934"/>
        <obo:IAO_0000115>A viral infectious disease that results_in infection, located_in skin, has_material_basis_in Vaccinia virus, which is used as a live vaccine against smallpox. The virus is transmitted_by contact with the vaccination site before it has healed, or transmitted_by fomites that have been contaminated with live virus from the vaccination site. The infection has_symptom rash, has_symptom fever, and has_symptom body aches.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>MESH:D014615</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:111852003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0042214</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:3298</oboInOwl:id>
        <rdfs:label>vaccinia</rdfs:label>
    </owl:Class>
    


