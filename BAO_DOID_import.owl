        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:187115002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0546996</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Cutaneous schistosomiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sea bather&apos;s eruption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
