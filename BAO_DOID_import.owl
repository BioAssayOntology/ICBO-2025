    <!-- http://purl.obolibrary.org/obo/DOID_11265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050339"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5614"/>
        <obo:IAO_0000115>A commensal bacterial infectious disease that results_in infection located_in eye, has_material_basis_in Chlamydia trachomatis (A, B, Ba and C serovars), which is transmitted_by contact with eye discharge from the infected person and transmitted_by congenital method. The infection causes eyelid to turn inward which makes eyelashes to scratch the cornea.</obo:IAO_0000115>
