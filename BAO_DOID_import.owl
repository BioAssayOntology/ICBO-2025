        <oboInOwl:hasDbXref>UMLS_CUI:C0036262</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Infestation by Sarcoptes scabiei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Infestation by Sarcoptes scabiei var hominis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sarcoptic itch</oboInOwl:hasExactSynonym>
