        <oboInOwl:hasDbXref>UMLS_CUI:C0155435</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9739</oboInOwl:id>
        <rdfs:label>eustachian tube disease</rdfs:label>
    </owl:Class>
    


