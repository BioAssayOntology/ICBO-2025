    <!-- http://purl.obolibrary.org/obo/DOID_0050633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5614"/>
        <obo:IAO_0000115>An eye disease that is characterized by reduced pigmentation of the iris and the resulting impairment of visual acuity without significantly affecting the color of skin or hair and has_material_basis in mutation in the GPR143 gene that encodes segments of the melanosomes that stores melanin.</obo:IAO_0000115>
