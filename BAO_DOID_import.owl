        <rdfs:comment>OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label>X-linked sideroblastic anemia with ataxia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0080015"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_9884"/>
        <obo:IAO_0000115>A muscular dystrophy that is characterized by diminished muscle tone (hypotonia), progressive muscle weakness and degeneration (atrophy), abnormally fixed joints, spinal rigidity, and delays in reaching motor milestones such as sitting or standing unassisted.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>GARD:9138</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:359.0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>OMIM:254100</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ORDO:97242</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:193221009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C2937300</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
