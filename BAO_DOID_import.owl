        <oboInOwl:hasDbXref>UMLS_CUI:C0018572</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Vesicular stomatitis and exanthem</oboInOwl:hasExactSynonym>
