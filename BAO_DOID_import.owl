        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:14230</oboInOwl:id>
        <rdfs:label>scleromalacia perforans</rdfs:label>
    </owl:Class>
    


