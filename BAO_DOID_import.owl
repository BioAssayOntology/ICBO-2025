    <!-- http://purl.obolibrary.org/obo/DOID_1024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050338"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2519"/>
