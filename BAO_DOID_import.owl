        <oboInOwl:id>DOID:0050559</oboInOwl:id>
        <rdfs:comment>OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label>Fukuyama congenital muscular dystrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050560 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050557"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050737"/>
        <obo:IAO_0000115>A congenital muscular dystrophy that is characterized by hypotonia, seizures, severe intellectual and developmental disability, eye abnormalities and early death and has_material_basis_in mutations in multiple genes including POMT1, POMT2, ISPD, FKTN, FKRP, and LARGE1.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
