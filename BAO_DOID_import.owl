        <oboInOwl:hasDbXref>UMLS_CUI:C0015652</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Fasciola hepatica infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Infection by Fasciola</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Liver flukes</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Sheep liver fluke infection</oboInOwl:hasExactSynonym>
