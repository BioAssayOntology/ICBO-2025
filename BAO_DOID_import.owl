        <oboInOwl:hasDbXref>UMLS_CUI:C0002438</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">amoebiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">entamoebiasis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
