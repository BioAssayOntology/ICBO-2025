        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:123319006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0007361</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Debre&apos;s Syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Debre-Mollaret Syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Foshay-Mollaret Cat Scratch Fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">benign lymphoreticulosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">cat scratch fever</oboInOwl:hasExactSynonym>
