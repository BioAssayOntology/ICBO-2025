        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_5614"/>
        <obo:IAO_0000115>An eye disease characterized by fundus hypopigmentation, decreased visual acuity, nystagmus, astigmatism, myopia and defective darkness adaptation and has_material_basis_in mutation in the CACNA1F gene.</obo:IAO_0000115>
