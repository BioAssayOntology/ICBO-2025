        <oboInOwl:hasDbXref>UMLS_CUI:C0024788</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Marburg disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Marburg virus disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
