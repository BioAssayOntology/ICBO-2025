    <!-- http://purl.obolibrary.org/obo/DOID_0060002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_626"/>
        <obo:IAO_0000115>A complement deficiency that is a functional deficiency in the complement component C1 inhibitor leading to hereditary angioedema (HAE) involving swelling due to leakage of fluid from blood vessels into connective tissue.</obo:IAO_0000115>
