        <rdfs:label>Kniest dysplasia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0080046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0080046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_225"/>
        <obo:IAO_0000115>A syndrome that is characterized by a distinctive facial appearance, eye abnormalities, hearing loss, and joint problems.</obo:IAO_0000115>
