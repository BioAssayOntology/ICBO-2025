        <oboInOwl:id>DOID:0050631</oboInOwl:id>
        <rdfs:comment>OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label>Allan-Herndon-Dudley syndrome</rdfs:label>
    </owl:Class>
    


