        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:8943</oboInOwl:id>
        <rdfs:label>lattice corneal dystrophy</rdfs:label>
    </owl:Class>
    


