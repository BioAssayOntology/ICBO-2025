        <oboInOwl:hasDbXref>UMLS_CUI:C0038159</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Staphylococcal food poisoning</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Staphylococcal toxaemia due to food</oboInOwl:hasExactSynonym>
