        <oboInOwl:hasExactSynonym xml:lang="en">vascular hemophilia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">vascular pseudohemophilia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">von Willebrand disease</oboInOwl:hasExactSynonym>
