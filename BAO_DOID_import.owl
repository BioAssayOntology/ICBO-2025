        <oboInOwl:hasDbXref>UMLS_CUI:C1442839</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9971</oboInOwl:id>
        <rdfs:label>hypervitaminosis D</rdfs:label>
    </owl:Class>
    


