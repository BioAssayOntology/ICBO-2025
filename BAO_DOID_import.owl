    <!-- http://purl.obolibrary.org/obo/DOID_9970 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_9970">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_654"/>
        <obo:IAO_0000115>An overnutrition that is characterized by excess body fat, traditionally defined as an elevated ratio of weight to height (specifically 30 kilograms per meter squared), has_material_basis_in a multifactorial etiology related to excess nutrition intake, decreased caloric utilization, and genetic susceptibility, and possibly medications and certain disorders of metabolism, endocrine function, and mental illness.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>EFO:0001073</oboInOwl:hasDbXref>
