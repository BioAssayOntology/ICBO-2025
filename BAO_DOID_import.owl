        <oboInOwl:hasDbXref>MESH:D009889</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:187124006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0029106</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Infection by Opisthorchis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13768</oboInOwl:id>
        <rdfs:label>opisthorchiasis</rdfs:label>
    </owl:Class>
    


