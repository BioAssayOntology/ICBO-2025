        <oboInOwl:hasExactSynonym xml:lang="en">His-Werner disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Quintan fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Wolhynian fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">shin bone fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">tibialgic fever</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11101</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#gram-negative_bacterial_infectious_disease"/>
        <rdfs:label>trench fever</rdfs:label>
        <skos:exactMatch>MESH:D014205</skos:exactMatch>
    </owl:Class>
    


