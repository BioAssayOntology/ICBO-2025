    <!-- http://purl.obolibrary.org/obo/DOID_0060786 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060786">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_10579"/>
        <obo:IAO_0000115>A leukodystrophy characterized by T2 hyperintensity and T1 iso- or hyperintensity of affected white matter in the central nervous system.</obo:IAO_0000115>
