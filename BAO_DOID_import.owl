    <!-- http://purl.obolibrary.org/obo/DOID_2769 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_2769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0060038"/>
        <obo:IAO_0000115>A specific developmental disorder that is characterized by the persistent presence of involuntary brief movements or sounds occuring intermittently and unpredictably out of a background of normal motor activity.</obo:IAO_0000115>
