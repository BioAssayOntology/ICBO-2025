    <!-- http://purl.obolibrary.org/obo/DOID_11262 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050338"/>
        <obo:IAO_0000115>A primary bacterial infectious disease that results_in systemic infection, has_material_basis_in Chlamydia psittaci, which is transmitted_by inhaling aerosolized dried droppings or transmitted_by contact with infected birds. The infection has_symptom fever, has_symptom headache, has_symptom rash, has_symptom chills, and has_symptom pneumonia.</obo:IAO_0000115>
