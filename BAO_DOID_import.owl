        <rdfs:label>cercarial dermatitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_11320 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_934"/>
        <obo:IAO_0000115>A viral infectious disease that is a hemorrhagic fever, has_material_basis_in Kyasanur forest disease virus, which is transmitted by Haemaphysalis spinigera tick bite. The infection has symptom fever, has symptom headache, has symptom stiffness of the neck, has symptom severe muscle pain, has symptom cough, has symptom dehydration, and has symptom bleeding problems.</obo:IAO_0000115>
