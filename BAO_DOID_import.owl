        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_104"/>
        <obo:IAO_0000115>A connective tissue disease that develops from an antecedent Group A Streptococcal pharyngeal infection and has_symptom carditis, has_symptom polyarthritis, has_symptom chorea, has_symptom erythema marginatum, has_symptom subcutaneous nodules, has_symptom arthralgia, has_symptom prolonged PR interval, and/or has_symptom fever.</obo:IAO_0000115>
