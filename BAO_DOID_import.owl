        <oboInOwl:id>DOID:0050573</oboInOwl:id>
        <rdfs:label>2-hydroxyglutaric aciduria</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050573"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2786"/>
        <obo:IAO_0000115>An 2-hydroxyglutaric aciduria that involves damage to cerebellum affecting movement coordination resulting in problems with balance and muscle coordination (ataxia).</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>GARD:10472</oboInOwl:hasDbXref>
