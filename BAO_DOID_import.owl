        <oboInOwl:hasDbXref>UMLS_CUI:C0080024</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">PIEBALD TRAIT</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Partial albinism</oboInOwl:hasExactSynonym>
