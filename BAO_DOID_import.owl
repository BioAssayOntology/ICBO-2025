        <oboInOwl:hasExactSynonym xml:lang="en">total anomalous pulmonary venous return</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vena cava bronchovascular syndrome</oboInOwl:hasExactSynonym>
