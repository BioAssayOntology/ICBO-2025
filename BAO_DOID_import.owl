    <!-- http://purl.obolibrary.org/obo/DOID_10883 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_10883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_403"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_934"/>
        <obo:IAO_0000115>A viral infectious disease that results in infection located in mouth, has_material_basis_in Human coxsackievirus A16, has_material_basis_in Human enterovirus 71, has_material_basis_in group B coxsackievirus, or has_material_basis_in echoviruses, which are transmitted by ingestion of food contaminated with feces, transmitted by contact with pharyngeal secretions, or transmitted by droplet spread of oronasal secretions. The infection has symptom fever, has symptom sore throat, and has symptom lesions in the back area of the mouth, particularly the soft palate or tonsillar pillars.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
