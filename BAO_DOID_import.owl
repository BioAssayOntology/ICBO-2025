        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:29608009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:80384002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0014541</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0155814</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">acute epiglottitis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">acute epiglottitis and supraglottitis</oboInOwl:hasExactSynonym>
