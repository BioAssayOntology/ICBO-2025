    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_2030"/>
        <obo:IAO_0000115>An anxiety disorder that is characterized by unexpected and repeated episodes of intense fear accompanied by physical symptoms that may include chest pain, heart palpitations, shortness of breath, dizziness, or abdominal distress.</obo:IAO_0000115>
