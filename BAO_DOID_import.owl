        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:0050558</oboInOwl:id>
        <rdfs:comment>OMIM mapping confirmed by DO. [SN].</rdfs:comment>
        <rdfs:label>Ullrich congenital muscular dystrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0050559 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0050559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0111229"/>
        <obo:IAO_0000115>A congenital muscular dystrophy-dystroglycanopathy type A that is characterized by muscle weakness, failure to thrive, severe intellectual and developmental disability, impaired vision and cardiac abnormalities and has_material_basis_in mutation in the FKTN gene that produces the fukutin protein.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
