        <rdfs:label xml:lang="en">thrombosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_0060904 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0060904">
