        <obo:IAO_0000115>A viral infectious disease that results_in infection, has_material_basis_in Lassa virus, which is transmitted_by multimammate rat of the genus Mastomys. The infection has_symptom fever, has_symptom retrosternal pain, has_symptom sore throat, has_symptom back pain, has_symptom cough, has_symptom abdominal pain, has_symptom vomiting, has_symptom diarrhea, has_symptom conjunctivitis, has_symptom facial swelling, has_symptom proteinuria (protein in the urine), and has_symptom mucosal bleeding.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>ICD10CM:A96.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007835</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCI:C128418</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:19065005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0023092</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:9537</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#NCIthesaurus"/>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#zoonotic_infectious_disease"/>
        <rdfs:label>Lassa fever</rdfs:label>
    </owl:Class>
    


