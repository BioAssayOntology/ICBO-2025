        <rdfs:label>paragonimiasis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_1070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1067"/>
