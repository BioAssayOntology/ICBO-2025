        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_65"/>
        <obo:IAO_0000115>A connective tissue disease that affects the structure or development of bone or causes an impairment of normal bone function.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
