        <oboInOwl:hasExactSynonym xml:lang="en">Bannwarth syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Bannworth&apos;s syndrome</oboInOwl:hasExactSynonym>
