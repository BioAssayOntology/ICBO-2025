    <!-- http://purl.obolibrary.org/obo/DOID_552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_850"/>
        <obo:IAO_0000115>A lung disease that involves lung parenchyma or alveolar inflammation and abnormal alveolar filling with fluid (consolidation and exudation). It results from a variety of causes including infection with bacteria, viruses, fungi or parasites, and chemical or physical injury to the lungs. It is accompanied by fever, chills, cough, and difficulty in breathing.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
