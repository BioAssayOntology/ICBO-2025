    <!-- http://purl.obolibrary.org/obo/DOID_13862 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_13862">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_1405"/>
        <obo:IAO_0000115>A primary angle-closure glaucoma characterized by acute closure of the anterior chamber angle by an intrinsic defect such that aqueous outflow is blocked and the intraocular pressure becomes suddenly inappropriately elevated threatening futher optic nerve damage and visual field loss. Acute closed-angle glaucoma has_symptom sudden pain, redness, headache, and blurry vision with haloes around lights. Acute closed-angle glaucoma can be caused by exacerbation of chronic primary angle-closure glaucoma, typically by a medication or state that dilates the eyes and thus narrows the anterior chamber angle, blocking any aqueous outflow.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>ICD10CM:H40.21</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:365.22</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:30041005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0154946</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">acute angle-closure glaucoma</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:13862</oboInOwl:id>
        <rdfs:label>acute closed-angle glaucoma</rdfs:label>
    </owl:Class>
    


