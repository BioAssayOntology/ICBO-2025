    <!-- http://purl.obolibrary.org/obo/DOID_3055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_3055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050338"/>
        <obo:IAO_0000115>A primary bacterial infectious disease that results_in infection located_in intestine, has_material_basis_in Salmonella enterica subsp enterica serovar Paratyphi A, B or C, which are transmitted_by ingestion of contaminated food. The infection has_symptom fever, has_symptom headache, has_symptom abdominal pain, has_symptom malaise, has_symptom anorexia, has_symptom constipation, has_symptom rosy spots on the central body, has_symptom non productive cough (in early stage of illness), has_symptom bradycardia, and has_symptom hepatosplenomegaly.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasAlternativeId>DOID:13324</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:13325</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>DOID:3053</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>ICD10CM:A01.1</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A01.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A01.3</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:A01.4</oboInOwl:hasDbXref>
