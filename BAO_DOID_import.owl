    <!-- http://purl.obolibrary.org/obo/DOID_0070329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_0070329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_700"/>
        <obo:IAO_0000115>A mitochondrial metabolism disease that is characterized by significant reduction in mitochondrial DNA in affected tissues, resulting in impaired mtDNA-encoded protein synthesis and energy production in the affected tissues and organs.</obo:IAO_0000115>
