        <oboInOwl:hasExactSynonym xml:lang="en">X-linked sideroblastic anaemia and ataxia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked sideroblastic anaemia with ataxia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">X-linked sideroblastic anemia and ataxia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
