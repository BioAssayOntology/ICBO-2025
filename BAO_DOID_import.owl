        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050177"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_8466"/>
        <obo:IAO_0000115>A retinal degeneration that characterized by progressive deterioration of the cone and rod photoreceptor cells.</obo:IAO_0000115>
