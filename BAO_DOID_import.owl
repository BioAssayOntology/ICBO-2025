    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_11336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050338"/>
        <obo:IAO_0000115>A primary bacterial infectious disease that involves the inflammation of mucosa lining the nasal cavity, pharynx, larynx, trachea and bronchi that is characterized by the formation of granulomas, dense induration of the tissues and nodular deformity caused by Klebsiella rhinoscleromatis.</obo:IAO_0000115>
