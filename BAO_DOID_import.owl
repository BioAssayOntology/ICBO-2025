    <!-- http://purl.obolibrary.org/obo/DOID_1562 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_0050135"/>
        <obo:IAO_0000115>A subcutaneous mycosis that is a chronic subcutaneous fungal infection, which presents as nodular or verrucoid, ulcerated, or crusted skin lesions on exposed areas of skin caused by Fonsecaea pedrosoi, Fonsecaea compacta, Cladophialophora carrionii or Phialophora verrucosa. Histological examination reveals muriform cells (with perpendicular septations) or thick walled, dark-colored, rounded forms (copper pennies) that are characteristic of this infection.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>GARD:1319</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD10CM:B43.9</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9CM:117.2</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D002862</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SNOMEDCT_US_2020_03_01:187079000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS_CUI:C0008582</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Chromomycosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Mossy foot disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:1562</oboInOwl:id>
        <rdfs:label>chromoblastomycosis</rdfs:label>
    </owl:Class>
    


