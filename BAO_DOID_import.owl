        <oboInOwl:hasDbXref>UMLS_CUI:C0600327</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">TSS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Toxic Shock syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">Toxic shock syndrome</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">toxic shock</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
