        <oboInOwl:hasExactSynonym xml:lang="en">lung fluke infection</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">pulmonary paragonimiasis</oboInOwl:hasExactSynonym>
