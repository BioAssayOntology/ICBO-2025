        <oboInOwl:hasDbXref>UMLS_CUI:C0038041</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym xml:lang="en">Spotted fever group rickettsial disease</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>disease_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>DOID:11104</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/doid#gram-negative_bacterial_infectious_disease"/>
        <rdfs:label>spotted fever</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/DOID_11105 -->

