    <!-- http://purl.obolibrary.org/obo/DOID_1389 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DOID_1389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DOID_574"/>
        <obo:IAO_0000115>A peripheral system disease that is characterized by damage affecting peripheral nerves (peripheral neuropathy) in roughly the same areas on both sides of the body, featuring weakness, numbness, pins-and-needles, and burning pain.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/doid.owl"/>
        <oboInOwl:hasDbXref>ICD10CM:A69.22</oboInOwl:hasDbXref>
